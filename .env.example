# ---------------------------------------------------------------------------
# sigil runs with none of these set. Every one is an upgrade, not a requirement.
# Copy to .env and fill in only what you need.
# ---------------------------------------------------------------------------

# --- face ---
# auto (default) prefers insightface and falls back to opencv.
SIGIL_FACE_BACKEND=auto
# Override the per-backend cosine threshold. Leave unset to use the default
# for whichever backend loads (insightface 0.38, opencv 0.363).
# SIGIL_THRESHOLD=0.38
# Set to 1 to run insightface on CUDA instead of CPU.
# SIGIL_GPU=1

# --- search ---
SIGIL_MAX_ACTORS=25
SIGIL_POSTS_PER_ACTOR=20
SIGIL_MAX_IMAGES=200

# Bluesky works fully unauthenticated. Supplying an app password additionally
# unlocks app.bsky.feed.searchPosts, which widens the search beyond accounts
# that match the query by name.
# Create one at Settings -> App Passwords (NOT your account password).
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional open-web arm: Google Lens reverse image search via SerpAPI.
# Only usable when the probe is passed as a public https URL.
# SERPAPI_KEY=

# --- chain ---
# local = persistent in-process EVM, zero setup. rpc = a real node.
SIGIL_CHAIN=local

# For SIGIL_CHAIN=rpc. Polygon Amoy testnet shown; any EVM chain works.
# Verified reachable: polygon-amoy-bor-rpc.publicnode.com and polygon-amoy.drpc.org.
# (rpc-amoy.polygon.technology, the endpoint most guides cite, was unreachable
#  when this was written - if you get a connection error, try another.)
# SIGIL_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# SIGIL_PRIVATE_KEY=0x...            # a throwaway key holding only testnet funds
# SIGIL_CONTRACT=0x...               # set after the first deploy to reuse it
# SIGIL_EXPLORER=https://amoy.polygonscan.com

# Salt for the on-chain subject commitment. Change it and previously anchored
# records will no longer verify against new probes - so pick one and keep it.
SIGIL_SUBJECT_SALT=sigil-default-salt
