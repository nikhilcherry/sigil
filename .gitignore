.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local chain state, compiled contract artifacts and evidence bundles are all
# run outputs - regenerated by `sigil run`, never source of truth.
artifacts/

# ONNX weights are fetched by scripts/fetch_models.sh; too large for git.
models/*.onnx

# The identity index is derived data - rebuild it with `sigil index build`
# rather than committing tens of MB of embeddings.
models/identity-index.*

# Secrets.
.env
